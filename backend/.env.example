# Patient Report Analyzer — Environment Variables
# Copy this file to .env and fill in values before running.
# Never commit .env to version control.

# --- JWT Authentication ---
# REQUIRED: Set a long random secret key in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# JWT algorithm — HS256 is fine for this project; no need to change.
JWT_ALGORITHM=HS256

# Token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# SQLite path (default: backend/reports.db, relative to main.py).
# For PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=reports.db

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Server ---
PORT=8000
